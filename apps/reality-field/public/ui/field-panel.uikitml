<!--
  REALITY//FIELD — the instrument panel.

  Plain UIKitML elements only: the Horizon kit's Panel ships a fixed-size
  background shape and its Button is sized for Quest system panels, so
  neither fits a compact instrument. Numeric sizes are UIKit units
  (centimetres): the panel is 34 cm wide, the text is 1.7 cm tall.
-->
<style>
  .panel-root {
    flex-direction: column;
    align-items: flex-start;
    width: 34;
    padding: 4;
    border-radius: 1.2;
    border-width: 0.1;
    border-color: rgba(120, 136, 155, 0.55);
    background-color: rgba(240, 244, 248, 0.92);
  }

  .panel-root:dark {
    border-color: rgba(255, 255, 255, 0.16);
    background-color: rgba(12, 16, 22, 0.86);
  }

  .heading {
    font-size: 2.8;
    font-weight: 700;
    color: #101418;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .rule {
    width: 26;
    height: 0.1;
    margin-top: 1.6;
    margin-bottom: 1.4;
    background-color: rgba(90, 100, 112, 0.45);
  }

  .rule:dark {
    background-color: rgba(255, 255, 255, 0.22);
  }

  .row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    align-self: flex-start;
    width: 26;
    margin-top: 0.8;
  }

  .label {
    font-size: 1.7;
    color: #5a6470;
  }

  .label:dark {
    color: rgba(255, 255, 255, 0.55);
  }

  .value {
    font-size: 1.7;
    font-weight: 600;
    color: #101418;
  }

  .value:dark {
    color: rgba(255, 255, 255, 0.92);
  }

  .button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: 26;
    min-width: 0;
    height: 4.4;
    margin-top: 1.4;
    border-radius: 0.8;
    border-width: 0.1;
    border-color: #9aa6b4;
    background-color: #e7ecf2;
    color: #101418;
  }

  .button:dark {
    border-color: rgba(255, 255, 255, 0.28);
    background-color: rgba(22, 29, 38, 0.9);
    color: rgba(255, 255, 255, 0.92);
  }

  .button-label {
    font-size: 1.9;
    font-weight: 600;
  }
</style>
<div class="panel-root">
  <div class="heading">REALITY//FIELD</div>
  <div class="rule"></div>
  <div class="row">
    <span class="label">MODE</span>
    <span id="mode-value" class="value">DREAM</span>
  </div>
  <div class="row">
    <span class="label">ROOM</span>
    <span id="room-value" class="value">searching...</span>
  </div>
  <div class="row">
    <span class="label">SURFACES</span>
    <span id="surfaces-value" class="value">0</span>
  </div>
  <div class="row">
    <span class="label">IMPACTS</span>
    <span id="impacts-value" class="value">0</span>
  </div>
  <div class="row">
    <span class="label">GESTURE</span>
    <span id="gesture-value" class="value">idle</span>
  </div>
  <div class="row">
    <span class="label">TENSION</span>
    <span id="tension-value" class="value">0.00</span>
  </div>
  <div class="row">
    <span class="label">FPS</span>
    <span id="fps-value" class="value">0</span>
  </div>
  <button id="mode-button" class="button">
    <span class="button-label">Debug view</span>
  </button>
  <button id="reset-button" class="button">
    <span class="button-label">Reset field</span>
  </button>
  <button id="xr-button" class="button">
    <span class="button-label">Enter XR</span>
  </button>
  <button id="exit-button" class="button" style="display: none">
    <span class="button-label">Exit to Browser</span>
  </button>
</div>
