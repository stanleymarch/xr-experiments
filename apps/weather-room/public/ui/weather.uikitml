<meta preferred-color-scheme="dark" />
<style>
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-Regular.ttf");
    font-weight: 400;
  }
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-Medium.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-SemiBold.ttf");
    font-weight: 600;
  }
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-Bold.ttf");
    font-weight: 700;
  }
  @font-face {
    font-family: "Unbounded";
    src: url("../fonts/Unbounded-Medium.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "Unbounded";
    src: url("../fonts/Unbounded-Bold.ttf");
    font-weight: 700;
  }
  .panel-root {
    flex-direction: column;
    width: 340px;
    height: 410px;
    background-color: #0d1930;
    border-color: #a9d8ff;
    border-width: 1px;
    border-radius: 14px;
  }
  .panel-content {
    align-items: stretch;
    flex-direction: column;
    padding-top: 10px;
    padding-left: 22px;
    padding-right: 22px;
  }
  .brand-kicker {
    font-family: "Geologica";
    font-size: 12px;
    font-weight: 600;
    line-height: 15px;
    letter-spacing: 2px;
    width: 100%;
    text-align: center;
    color: #79d7f2;
  }
  .heading {
    font-family: "Unbounded";
    height: 30px;
    text-align: center;
    font-size: 21px;
    font-weight: 700;
    line-height: 26px;
    letter-spacing: 1px;
    margin-top: 4px;
    color: #eef5ff;
  }
  .heading:dark {
    color: #eef5ff;
  }
  .mode-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
  }
  .mode-pill {
    font-family: "Geologica";
    font-size: 12px;
    font-weight: 700;
    line-height: 15px;
    letter-spacing: 1.5px;
    padding-top: 3px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 3px;
    border-radius: 999px;
    background-color: #79d7f2;
    color: #060b18;
    text-align: center;
  }
  .panel-view {
    flex-direction: column;
  }
  .playhead {
    font-family: "Geologica";
    color: #eef5ff;
    font-size: 19px;
    font-weight: 600;
    line-height: 24px;
    width: 100%;
    margin-top: 4px;
    text-align: center;
  }
  .playhead:dark {
    color: #eef5ff;
  }
  .hero-temp {
    font-family: "Geologica";
    color: #eef5ff;
    font-size: 32px;
    font-weight: 700;
    line-height: 38px;
    width: 100%;
    margin-top: 0px;
    text-align: center;
  }
  .hero-temp:dark {
    color: #eef5ff;
  }
  .subhead {
    font-family: "Geologica";
    color: #a6bcd9;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    width: 100%;
    margin-top: 3px;
    text-align: center;
  }
  .subhead:dark {
    color: #a6bcd9;
  }
  .values {
    font-family: "Geologica";
    color: #eef5ff;
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    width: 100%;
    margin-top: 2px;
    text-align: center;
  }
  .values:dark {
    color: #eef5ff;
  }
  .status {
    font-family: "Geologica";
    color: #a6bcd9;
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
    width: 100%;
    margin-top: 4px;
    text-align: center;
  }
  .status:dark {
    color: #a6bcd9;
  }
  .timeline-hint {
    font-family: "Geologica";
    color: #7e99bd;
    font-size: 11px;
    font-weight: 600;
    line-height: 14px;
    width: 100%;
    margin-top: 4px;
    text-align: center;
    letter-spacing: 0.5px;
  }
  .timeline-hint:dark {
    color: #7e99bd;
  }
  .controls-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
  }
  .control-button {
    width: 88px;
    margin-left: 4px;
    margin-right: 4px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .button-label {
    transform-translate-y: 1px;
    width: 100%;
    text-align: center;
  }
  .sandbox-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
  }
  .sandbox-button {
    width: 200px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .sandbox-label {
    font-size: 13px;
    width: 100%;
    text-align: center;
  }
  .sandbox-hint {
    font-family: "Geologica";
    color: #7e99bd;
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    width: 100%;
    margin-top: 4px;
    padding-left: 22px;
    padding-right: 22px;
    text-align: center;
  }
  .sandbox-hint:dark {
    color: #7e99bd;
  }
  .xr-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 8px;
  }
  .utility-button {
    width: 80px;
    margin-left: 2px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .utility-label {
    font-size: 12px;
    width: 100%;
    text-align: center;
  }
  .picker-button {
    width: 140px;
    margin-left: 2px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .picker-label {
    font-size: 14px;
    width: 100%;
    text-align: center;
  }
  .picker {
    display: none;
    flex-direction: column;
    justify-content: center;
    flex-grow: 1;
    padding-top: 24px;
    padding-left: 22px;
    padding-right: 22px;
  }
  .picker-title {
    font-family: "Geologica";
    font-size: 24px;
    line-height: 30px;
    font-weight: 700;
    text-align: center;
    color: #eef5ff;
    margin-bottom: 12px;
  }
  .picker-hint {
    font-family: "Geologica";
    font-weight: 500;
    font-size: 13px;
    line-height: 19px;
    color: #a6bcd9;
    text-align: center;
    margin-top: 16px;
  }
</style>
<Panel id="weather-root" class="panel-root">
  <div id="weather-view" class="panel-view">
    <div class="panel-content">
      <div class="brand-kicker">STANIVERSE</div>
      <div class="heading">WEATHER//ROOM</div>
      <div class="mode-row">
        <div id="mode-badge" class="mode-pill">LOADING</div>
      </div>
      <div id="playhead-line" class="playhead">…</div>
      <div id="hero-line" class="hero-temp">--</div>
      <div id="location-line" class="subhead">Locating...</div>
      <div id="values-line" class="values">--</div>
      <div id="status-line" class="status">Loading...</div>
      <div id="timeline-hint" class="timeline-hint">-24H &lt; KNOB / BUTTONS &gt; +24H</div>
    </div>
    <div class="controls-row">
      <Button id="back-button" class="control-button" variant="secondary">
        <ButtonLabel id="back-label" class="button-label">-6h</ButtonLabel>
      </Button>
      <Button id="now-button" class="control-button" variant="primary">
        <ButtonLabel id="now-label" class="button-label">NOW</ButtonLabel>
      </Button>
      <Button id="forward-button" class="control-button" variant="secondary">
        <ButtonLabel id="forward-label" class="button-label">+6h</ButtonLabel>
      </Button>
    </div>
    <div class="sandbox-row">
      <Button id="sandbox-button" class="sandbox-button" variant="secondary">
        <ButtonLabel id="sandbox-label" class="sandbox-label">Sandbox: OFF</ButtonLabel>
      </Button>
    </div>
    <div id="sandbox-hint" class="sandbox-hint">Tap to arm. Clap = thunder.</div>
    <div class="xr-row">
      <Button id="reload-button" class="utility-button" variant="tertiary">
        <ButtonLabel id="reload-label" class="utility-label">Reload</ButtonLabel>
      </Button>
      <Button id="location-button" class="utility-button" variant="tertiary">
        <ButtonLabel id="location-label" class="utility-label">Location</ButtonLabel>
      </Button>
      <Button id="lang-button" class="utility-button" variant="tertiary">
        <ButtonLabel id="lang-label" class="utility-label">RU</ButtonLabel>
      </Button>
      <Button id="exit-button" class="utility-button" variant="tertiary">
        <ButtonLabel id="exit-label" class="utility-label">Exit</ButtonLabel>
      </Button>
    </div>
  </div>
  <div id="location-picker" class="picker">
    <div id="location-picker-title" class="picker-title">Choose a city</div>
    <div id="picker-location-line" class="subhead">--</div>
    <div class="controls-row">
      <Button id="location-moscow" class="picker-button" variant="secondary">
        <ButtonLabel id="location-moscow-label" class="picker-label">Moscow</ButtonLabel>
      </Button>
      <Button id="location-saint-petersburg" class="picker-button" variant="secondary">
        <ButtonLabel id="location-saint-petersburg-label" class="picker-label">St Petersburg</ButtonLabel>
      </Button>
    </div>
    <div class="xr-row">
      <Button id="location-london" class="picker-button" variant="secondary">
        <ButtonLabel id="location-london-label" class="picker-label">London</ButtonLabel>
      </Button>
      <Button id="location-berlin" class="picker-button" variant="secondary">
        <ButtonLabel id="location-berlin-label" class="picker-label">Berlin</ButtonLabel>
      </Button>
    </div>
    <div class="xr-row">
      <Button id="location-new-york" class="picker-button" variant="secondary">
        <ButtonLabel id="location-new-york-label" class="picker-label">New York</ButtonLabel>
      </Button>
      <Button id="location-tokyo" class="picker-button" variant="secondary">
        <ButtonLabel id="location-tokyo-label" class="picker-label">Tokyo</ButtonLabel>
      </Button>
    </div>
    <div class="xr-row">
      <Button id="location-auto-button" class="picker-button" variant="primary">
        <ButtonLabel id="location-auto-label" class="picker-label">My location</ButtonLabel>
      </Button>
      <Button id="location-back-button" class="picker-button" variant="tertiary">
        <ButtonLabel id="location-back-label" class="picker-label">Back</ButtonLabel>
      </Button>
    </div>
    <div id="location-picker-hint" class="picker-hint">My location uses device/IP.</div>
  </div>
</Panel>
