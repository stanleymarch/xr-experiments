<style>
  .panel-root {
    flex-direction: column;
    width: 380px;
  }
  .panel-content {
    align-items: stretch;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 24px;
    padding-right: 24px;
  }
  .heading {
    height: 40px;
    text-align: center;
    font-size: 22px;
    font-weight: 700;
    line-height: 22px;
    letter-spacing: -0.5px;
    color: #272727;
  }
  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }
  .status {
    color: #5a6b82;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    width: 100%;
    margin-top: 4px;
    text-align: center;
  }
  .playhead {
    color: #272727;
    font-size: 18px;
    font-weight: 700;
    line-height: 20px;
    width: 100%;
    margin-top: 10px;
    text-align: center;
  }
  .playhead:dark {
    color: rgba(255, 255, 255, 0.9);
  }
  .values {
    color: #272727;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    width: 100%;
    margin-top: 8px;
  }
  .values:dark {
    color: rgba(255, 255, 255, 0.9);
  }
  .timeline-hint {
    color: #5a6b82;
    font-size: 11px;
    font-weight: 600;
    line-height: 14px;
    width: 100%;
    margin-top: 5px;
    text-align: center;
  }
  .button {
    justify-content: flex-start;
    margin-left: 24px;
    margin-right: 24px;
    margin-top: 10px;
    margin-bottom: 8px;
  }
  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">WEATHER//ROOM</div>
    <Divider></Divider>
    <div id="status-line" class="status">Locating...</div>
    <div id="location-line" class="status">--</div>
    <div id="playhead-line" class="playhead">NOW</div>
    <div id="values-line" class="values">--</div>
    <div class="timeline-hint">-24h  &lt; DRAG &gt;  +24h</div>
  </div>
  <div class="row">
    <Button id="now-button" class="button">
      <ButtonLabel class="button-label">NOW</ButtonLabel>
    </Button>
    <Button id="reload-button" class="button">
      <ButtonLabel class="button-label">Reload</ButtonLabel>
    </Button>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon>
      <RectangleGoggles></RectangleGoggles>
    </ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon>
      <LogIn></LogIn>
    </ButtonIcon>
    <ButtonLabel class="button-label">Exit to Browser</ButtonLabel>
  </Button>
</Panel>
