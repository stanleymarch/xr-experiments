<meta preferred-color-scheme="dark" />
<style>
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-Regular.ttf");
    font-weight: 400;
  }
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-Medium.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-SemiBold.ttf");
    font-weight: 600;
  }
  @font-face {
    font-family: "Geologica";
    src: url("../fonts/Geologica-Bold.ttf");
    font-weight: 700;
  }
  @font-face {
    font-family: "Unbounded";
    src: url("../fonts/Unbounded-Medium.ttf");
    font-weight: 500;
  }
  @font-face {
    font-family: "Unbounded";
    src: url("../fonts/Unbounded-Bold.ttf");
    font-weight: 700;
  }
  .panel-root {
    flex-direction: column;
    width: 340px;
  }
  .panel-content {
    align-items: stretch;
    flex-direction: column;
    padding-top: 18px;
    padding-left: 22px;
    padding-right: 22px;
  }
  .brand-kicker {
    font-family: "Geologica";
    font-size: 11px;
    font-weight: 600;
    line-height: 14px;
    letter-spacing: 2.5px;
    width: 100%;
    text-align: center;
    color: #79d7f2;
  }
  .heading {
    font-family: "Unbounded";
    height: 30px;
    text-align: center;
    font-size: 21px;
    font-weight: 700;
    line-height: 26px;
    letter-spacing: 1px;
    margin-top: 4px;
    color: #eef5ff;
  }
  .heading:dark {
    color: #eef5ff;
  }
  .mode-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
  }
  .mode-pill {
    font-family: "Geologica";
    font-size: 11px;
    font-weight: 700;
    line-height: 14px;
    letter-spacing: 1.5px;
    padding-top: 3px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 3px;
    border-radius: 999px;
    background-color: #79d7f2;
    color: #060b18;
    text-align: center;
  }
  .revision {
    font-family: "Geologica";
    color: #94aac8;
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    margin-left: 8px;
  }
  .playhead {
    font-family: "Geologica";
    color: #eef5ff;
    font-size: 34px;
    font-weight: 700;
    line-height: 38px;
    width: 100%;
    margin-top: 8px;
    text-align: center;
  }
  .playhead:dark {
    color: #eef5ff;
  }
  .hero-temp {
    font-family: "Geologica";
    color: #eef5ff;
    font-size: 24px;
    font-weight: 700;
    line-height: 30px;
    width: 100%;
    margin-top: 4px;
    text-align: center;
  }
  .hero-temp:dark {
    color: #eef5ff;
  }
  .subhead {
    font-family: "Geologica";
    color: #94aac8;
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    width: 100%;
    margin-top: 4px;
    text-align: center;
  }
  .subhead:dark {
    color: #94aac8;
  }
  .values {
    font-family: "Geologica";
    color: #eef5ff;
    font-size: 15px;
    font-weight: 600;
    line-height: 23px;
    width: 100%;
    margin-top: 6px;
    text-align: center;
  }
  .values:dark {
    color: #eef5ff;
  }
  .status {
    font-family: "Geologica";
    color: #5f7896;
    font-size: 10px;
    font-weight: 500;
    line-height: 14px;
    width: 100%;
    margin-top: 10px;
    text-align: center;
  }
  .status:dark {
    color: #5f7896;
  }
  .timeline-hint {
    font-family: "Geologica";
    color: #79d7f2;
    font-size: 10px;
    font-weight: 600;
    line-height: 13px;
    width: 100%;
    margin-top: 8px;
    text-align: center;
    letter-spacing: 1px;
  }
  .timeline-hint:dark {
    color: #79d7f2;
  }
  .controls-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 10px;
    margin-bottom: 6px;
  }
  .control-button {
    width: 70px;
    margin-left: 3px;
    margin-right: 3px;
  }
  .button-label {
    transform-translate-y: 1px;
  }
  .xr-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
  }
</style>
<Panel id="weather-root" class="panel-root">
  <div class="panel-content">
    <div class="brand-kicker">STANIVERSE</div>
    <div class="heading">WEATHER//ROOM</div>
    <div class="mode-row">
      <div id="mode-badge" class="mode-pill">LIVE</div>
      <div id="revision-label" class="revision">rev --</div>
    </div>
    <div id="playhead-line" class="playhead">NOW</div>
    <div id="hero-line" class="hero-temp">--</div>
    <div id="location-line" class="subhead">Locating...</div>
    <div id="values-line" class="values">--</div>
    <div id="status-line" class="status">Loading...</div>
    <div id="timeline-hint" class="timeline-hint">-24H &lt; GRAB KNOB / TAP BUTTONS &gt; +24H</div>
  </div>
  <div class="controls-row">
    <Button id="back-button" class="control-button" variant="secondary">
      <ButtonLabel id="back-label" class="button-label">-6h</ButtonLabel>
    </Button>
    <Button id="now-button" class="control-button" variant="primary">
      <ButtonLabel id="now-label" class="button-label">NOW</ButtonLabel>
    </Button>
    <Button id="forward-button" class="control-button" variant="secondary">
      <ButtonLabel id="forward-label" class="button-label">+6h</ButtonLabel>
    </Button>
  </div>
  <div class="xr-row">
    <Button id="reload-button" class="control-button" variant="tertiary">
      <ButtonLabel id="reload-label" class="button-label">Reload</ButtonLabel>
    </Button>
    <Button id="xr-button" class="control-button" variant="primary">
      <ButtonLabel id="xr-label" class="button-label">Enter AR</ButtonLabel>
    </Button>
    <Button id="exit-button" class="control-button" variant="tertiary">
      <ButtonLabel id="exit-label" class="button-label">Exit</ButtonLabel>
    </Button>
    <Button id="lang-button" class="control-button" variant="tertiary">
      <ButtonLabel id="lang-label" class="button-label">RU</ButtonLabel>
    </Button>
    <Button id="location-button" class="control-button" variant="tertiary">
      <ButtonLabel id="location-label" class="button-label">Loc</ButtonLabel>
    </Button>
  </div>
</Panel>
